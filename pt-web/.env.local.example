# Public - safe to expose to the browser (this is the anon key, scoped by the same RLS
# policies the Android app's Supabase client uses). Use the legacy JWT anon key (starts with
# "eyJ..."), the same one already shipped in the Android app's local.properties/CI secret -
# not the newer "sb_publishable_..." key, to keep both clients on the exact same key format.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
